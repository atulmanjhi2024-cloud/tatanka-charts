    "default": "Price + Text"
   },
   {
    "name": "WrapCharacters",
    "group": "1. General",
    "order": 18,
    "label": "Line label wrap width (chars, 0 = off)",
    "type": "int",
    "description": "Wrap at word boundaries; preserve literal backslash-n manual breaks. Long words remain whole.",
    "min": 0,
    "max": 120,
    "default": 50
   },
   {
    "name": "LabelOffset",
    "group": "1. General",
    "order": 19,
    "label": "Line label room (bars right of last candle)",
    "type": "int",
    "description": "The labels sit at the chart's right edge, so they stay put when you zoom or scroll; this is the room kept for them right of the last candle (NinjaTrader draws them this many bars after it).",
    "min": 0,
    "max": 500,
    "default": 75
   },
   {
    "name": "LabelBackground",
    "group": "1. General",
    "order": 20,
    "label": "Label background",
    "type": "bool",
    "description": "Use table background color behind line labels.",
    "default": true
   },
   {
    "name": "ShowTable",
    "group": "1. General",
    "order": 21,
    "label": "Show table",
    "type": "bool",
    "description": "Show or hide the table independently of lines, labels and zones.",
    "default": false
   },
   {
    "name": "BackgroundBrush",
    "group": "2. Table style",
    "order": 22,
    "label": "Background color",
    "type": "color",
    "description": "Base table cell color and optional label plate color. Alpha is honored.",
    "default": "#060606"
   },
   {
    "name": "ActiveRowOpacity",
    "group": "2. Table style",
    "order": 23,
    "label": "Active-row opacity",
    "type": "int",
    "description": "Active row fill strength: 0 = transparent, 100 = solid.",
    "min": 0,
    "max": 100,
    "default": 25
   },
   {
    "name": "BorderBrush",
    "group": "2. Table style",
    "order": 24,
    "label": "Border color",
    "type": "color",
    "description": "One-pixel table cell borders and frame.",
    "default": "#060606"
   },
   {
    "name": "RowsBlock",
    "group": "3. If/Then block",
    "order": 25,
    "label": "Rows  (BIAS|LO|HI|TEXT)",
    "type": "text",
    "description": "One row per line. U/V/N/D/P. 9999999 = open-top display, 0 = open-bottom display. Literal backslash-n creates text breaks; # at column 1 is a comment.",
    "default": "U|5050|9999999|Accepts above 5050 \u2192 continuation, next target 5085\nV|5005|5050|Above pivot, holding value \u2192 grind higher\nP|4995|5005|Pivot ~5000 \u2014 the day's reference\nD|4960|4995|Below pivot, no reclaim \u2192 4960 support in play\nD|0|4960|Below 4960 \u2192 range break, downside opens up"
   }
  ]
 },
