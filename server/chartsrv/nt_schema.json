 "gap": {
  "title": "Tatanka Gap Analysis",
  "version": "1.0.0",
  "settings": [
   {
    "name": "EnabledAnalysis",
    "group": "01. Gap Settings",
    "order": 0,
    "label": "Enable gap analysis",
    "type": "bool",
    "default": true
   },
   {
    "name": "RthStart",
    "group": "01. Gap Settings",
    "order": 1,
    "label": "RTH start (Chicago HHmmss)",
    "type": "int",
    "description": "Chicago time, including daylight saving time. Default 08:30:00. Written for ES/NQ's 08:30-15:00 CT: on another instrument it moves with that one's regular hours (CL's 08:30 is 08:00, its 15:00 13:30).",
    "min": 0,
    "max": 235959,
    "default": 83000
   },
   {
    "name": "RthEnd",
    "group": "01. Gap Settings",
    "order": 2,
    "label": "RTH end (Chicago HHmmss)",
    "type": "int",
    "description": "Default 15:00:00. Reference price is the last loaded RTH chart-bar close. Written for ES/NQ's 08:30-15:00 CT: on another instrument it moves with that one's regular hours (CL's 08:30 is 08:00, its 15:00 13:30).",
    "min": 0,
    "max": 235959,
    "default": 150000
   },
   {
    "name": "MinimumGapPoints",
    "group": "01. Gap Settings",
    "order": 3,
    "label": "Minimum gap size (points)",
    "type": "float",
    "min": 0.0,
    "max": null,
    "default": 0.0
   },
   {
    "name": "MaximumGapsToShow",
    "group": "01. Gap Settings",
    "order": 4,
    "label": "Maximum visible gaps (0 = all)",
    "type": "int",
    "description": "Zero displays all eligible gaps intersecting the visible time range. All loaded gaps remain tracked regardless of this display setting.",
    "min": 0,
    "max": null,
    "default": 0
   },
   {
    "name": "ExtendUnfilledRight",
    "group": "01. Gap Settings",
    "order": 5,
    "label": "Extend unfilled gaps right",
    "type": "bool",
    "default": true
   },
   {
    "name": "ShowGapZones",
    "group": "02. Visual Settings",
    "order": 0,
    "label": "Show gap shading",
    "type": "bool",
    "default": true
   },
   {
    "name": "ShrinkPartiallyFilledZones",
    "group": "02. Visual Settings",
    "order": 1,
    "label": "Shrink partially filled zones",
    "type": "bool",
    "description": "Wicks reduce the unfilled area. Filled portions never grow back when price retreats.",
    "default": true
   },
   {
    "name": "ShowTouchedArea",
    "group": "02. Visual Settings",
    "order": 2,
    "label": "Show partially filled area",
    "type": "bool",
    "description": "Shade the touched portion separately. Applies when shrinking is enabled.",
    "default": true
   },
   {
    "name": "HideFilledGaps",
    "group": "02. Visual Settings",
    "order": 3,
    "label": "Hide fully filled gaps",
    "type": "bool",
    "default": true
   },
   {
    "name": "ShowSettleLines",
    "group": "02. Visual Settings",
    "order": 4,
    "label": "Show RTH close target lines",
    "type": "bool",
    "default": true
   },
   {
    "name": "SettleLineStyle",
    "group": "02. Visual Settings",
    "order": 5,
    "label": "Target line style",
    "choices": [
     "Solid",
     "Dashed",
     "Dotted"
    ],
    "type": "choice",
    "default": "Dashed"
   },
   {
    "name": "SettleLineWidth",
    "group": "02. Visual Settings",
    "order": 6,
    "label": "Target line width",
    "type": "int",
    "min": 1,
    "max": 4,
    "default": 1
   },
   {
    "name": "ShowGapLabels",
    "group": "02. Visual Settings",
    "order": 7,
    "label": "Show gap labels",
    "type": "bool",
    "default": true
   },
   {
    "name": "LabelFontSize",
    "group": "02. Visual Settings",
    "order": 8,
    "label": "Label font size",
    "type": "int",
    "min": 8,
    "max": 36,
    "default": 12
   },
   {
    "name": "GapOpacity",
    "group": "02. Visual Settings",
    "order": 9,
    "label": "Unfilled zone opacity (%)",
    "type": "int",
    "min": 0,
    "max": 100,
    "default": 20
   },
   {
    "name": "FilledOpacity",
    "group": "02. Visual Settings",
    "order": 10,
    "label": "Filled area opacity (%)",
    "type": "int",
    "min": 0,
    "max": 100,
    "default": 10
   },
   {
    "name": "BullGapBrush",
    "group": "02. Visual Settings",
    "order": 11,
    "label": "Up gap color",
    "type": "color",
    "default": "#32cd32"
   },
   {
    "name": "BearGapBrush",
    "group": "02. Visual Settings",
    "order": 12,
    "label": "Down gap color",
    "type": "color",
    "default": "#cd5c5c"
   },
   {
    "name": "FilledGapBrush",
    "group": "02. Visual Settings",
    "order": 13,
    "label": "Filled gap color",
    "type": "color",
    "default": "#708090"
   },
   {
    "name": "ShowGapTable",
    "group": "03. Table Settings",
    "order": 0,
    "label": "Show gap table",
    "type": "bool",
    "default": true
   },
   {
    "name": "TablePosition",
    "group": "03. Table Settings",
    "order": 1,
    "label": "Table position",
    "choices": [
     "TopRight",
     "TopLeft",
     "BottomRight",
     "BottomLeft",
     "MiddleRight",
     "MiddleLeft"
    ],
    "type": "choice",
    "default": "TopRight"
   },
   {
    "name": "TableFontSize",
    "group": "03. Table Settings",
    "order": 2,
    "label": "Table font size",
    "type": "int",
    "min": 8,
    "max": 24,
    "default": 13
   },
   {
    "name": "AlertOnNewGap",
    "group": "04. Alerts",
    "order": 0,
    "label": "Alert on new gap",
    "type": "bool",
    "description": "Real-time alerts only. Historical gaps do not replay alerts.",
    "default": true
   },
   {
    "name": "AlertOnGapFill",
    "group": "04. Alerts",
    "order": 1,
    "label": "Alert on full gap fill",
    "type": "bool",
    "default": true
   }
  ]
 },
 "hema": {
  "title": "HTF EMA",
  "version": "1.0.0",
  "settings": [
   {
    "name": "HtfPeriodType",
    "group": "Parameters",
    "order": 1,
    "label": "Source timeframe type",
    "choices": [
     "Minute",
     "Day"
    ],
    "type": "choice",
    "description": "Pine input.timeframe type. Default Minute + 60 = 1 hour.",
    "default": "Minute"
   },
   {
    "name": "HtfPeriod",
    "group": "Parameters",
    "order": 2,
    "label": "Source timeframe",
    "type": "int",
    "description": "Pine input.timeframe value. 60 with Minute = 1 hour.",
    "min": 1,
    "max": null,
    "default": 60
   },
   {
    "name": "EmaLength",
    "group": "Parameters",
    "order": 3,
    "label": "EMA length",
    "type": "int",
    "description": "Pine i_len. Default 21.",
    "min": 1,
    "max": null,
    "default": 21
   },
   {
    "name": "Mode",
    "group": "Parameters",
    "order": 4,
    "label": "Mode",
    "choices": [
     "LiveHTF",
     "ExactHTF",
     "SmoothScaled"
    ],
    "type": "choice",
    "description": "LiveHTF = developing HTF EMA. ExactHTF = last closed HTF EMA. SmoothScaled = chart-TF EMA with scaled length.",
    "default": "SmoothScaled"
   },
   {
    "name": "PlotHTFEMA",
    "group": "Plots",
    "order": 1,
    "label": "HTF EMA",
    "type": "stroke",
    "default": {
     "color": "#808080",
     "dash": "Solid",
     "width": 2.0
    }
   }
  ]
 },
 "ifthen": {
  "title": "If/Then Bias Table",
  "version": "1.0.0",
  "settings": [
   {
    "name": "InstrumentLabel",
    "group": "1. General",
    "order": 0,
    "label": "Instrument label",
