    "description": "Position color below price.",
    "default": "#4caf50"
   },
   {
    "name": "WithinBrush",
    "group": "1. General",
    "order": 15,
    "label": "Position: within ATR band (neutral)",
    "type": "color",
    "description": "Position color inside the neutral band, including its edges.",
    "default": "#ffeb3b"
   },
   {
    "name": "LineLabels",
    "group": "1. General",
    "order": 16,
    "label": "Label boundary lines",
    "type": "bool",
    "description": "Print right-aligned text above each positive Lo.",
    "default": true
   },
   {
    "name": "LabelContent",
    "group": "1. General",
    "order": 17,
    "label": "Line label content",
    "choices": [
     "Text",
     "Price",
     "Price + Text"
    ],
    "type": "choice",
