    "max": null,
    "default": 2.0
   },
   {
    "name": "ZoneOpacity",
    "group": "1. General",
    "order": 12,
    "label": "Zone fill opacity",
    "type": "int",
    "description": "Source semantics: TRANSPARENCY. 100 = invisible; 0 = solid. Inactive rows add 8.",
    "min": 0,
    "max": 100,
    "default": 75
   },
   {
    "name": "AboveBrush",
    "group": "1. General",
    "order": 13,
