    "description": "Header instrument label; independent of the chart instrument.",
    "default": "ES"
   },
   {
    "name": "PriceSource",
    "group": "1. General",
    "order": 1,
    "label": "Price source",
    "choices": [
     "Close",
     "Open",
     "High",
     "Low",
     "HL2",
     "HLC3",
     "OHLC4",
     "HLCC4",
     "Input series"
    ],
    "type": "choice",
    "description": "Close updates live each tick. Input series uses the Data series > Input series selector, including another indicator.",
    "default": "Close"
   },
   {
    "name": "TablePosition",
    "group": "1. General",
    "order": 2,
    "label": "Table position",
    "choices": [
     "Top Right",
     "Middle Right",
     "Bottom Right",
     "Top Left",
     "Middle Left",
     "Bottom Left"
    ],
    "type": "choice",
    "description": "Anchor the table to one of six chart-panel positions.",
    "default": "Middle Right"
   },
   {
    "name": "TextSize",
    "group": "1. General",
    "order": 3,
    "label": "Text size",
    "choices": [
     "Tiny",
     "Small",
     "Normal",
     "Large"
    ],
    "type": "choice",
    "description": "Tiny / Small / Normal / Large. Font metrics depend on the platform.",
    "default": "Normal"
   },
   {
    "name": "ShowLines",
    "group": "1. General",
    "order": 4,
    "label": "Plot boundary lines on chart",
    "type": "bool",
    "description": "Draw a horizontal line at each positive Lo.",
    "default": true
   },
   {
    "name": "LineWidth",
    "group": "1. General",
    "order": 5,
    "label": "Boundary line width",
    "type": "int",
    "description": "Thickness of the boundary lines.",
    "min": 1,
    "max": 5,
    "default": 2
   },
   {
    "name": "LineStyle",
    "group": "1. General",
    "order": 6,
    "label": "Boundary line style",
    "choices": [
     "Solid",
     "Dashed",
     "Dotted"
    ],
    "type": "choice",
    "description": "Solid, Dashed or Dotted.",
    "default": "Solid"
   },
   {
    "name": "LineColorMode",
    "group": "1. General",
    "order": 7,
    "label": "Line/label color",
    "choices": [
     "Bias",
     "Position"
    ],
    "type": "choice",
    "description": "Position: above price = resistance; below = support; within the ATR band = neutral. Pivot remains yellow.",
    "default": "Bias"
   },
   {
    "name": "AtrLength",
    "group": "1. General",
    "order": 8,
    "label": "ATR length (Position band, daily)",
    "type": "int",
    "description": "Daily Wilder ATR length. Uses the previous daily ATR, irrespective of chart timeframe.",
