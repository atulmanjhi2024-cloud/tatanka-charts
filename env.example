# Template. Save a copy named .env in this folder (git-ignored) and fill it in. Everything is optional.
# The app's Connections (the dot at the top right) sets most of these too; a value saved there wins over this file.

# Feeds: sim (dev random walk) | ninjatrader (the main futures feed, via the TatankaChartFeed add-on) | none
CHART_FEED=sim
# Optional shared secret for the NinjaTrader add-on; set the same value as Token in TatankaChartFeed.cs
CHART_NT_TOKEN=
# Watchlist quotes: ibkr, alpaca, coinbase, yahoo, sim or none, comma-separated; the first beats the next (ibkr,yahoo = IBKR, with Yahoo
# for what IBKR lacks or while it is down). Empty: sim quotes (fake) with the sim feed, else yahoo. NinjaTrader's own
# futures quotes always come first. Sim quotes never run alongside a real feed.
CHART_QUOTES_FEED=
# Seconds between Yahoo rounds (20 symbols a request):
CHART_YAHOO_POLL_S=15
# Free FRED API key (fred.stlouisfed.org > My Account > API Keys): the symbol search then finds every FRED series.
# FRED charts and watchlist values work without it.
FRED_API_KEY=
# Free EIA key (eia.gov/opendata): EIA's energy series (crude and Cushing stocks, natural gas storage).
EIA_API_KEY=
# Alpaca (free account at alpaca.markets): real-time US stock quotes. Add alpaca to CHART_QUOTES_FEED.
ALPACA_KEY_ID=
ALPACA_SECRET=
# iex (free) or sip (paid data plan)
ALPACA_FEED=iex
# 0 keeps the symbol database from refreshing online (Nasdaq Trader, Coinbase) and searches from asking Yahoo.
CHART_SYMBOLS_ONLINE=1

# Alert delivery. A Discord channel's webhook (a private channel).
CHART_DISCORD_WEBHOOK=
# Phone push via ntfy: install the ntfy app, subscribe to a long random topic, put its URL here.
CHART_NTFY_URL=
# App notifications (Web Push) need no setting. The push services' contact for this server (a URL or mailto:; blank:
# https://github.com/tatankatrading/tatanka-charts):
CHART_PUSH_SUBJECT=
# Daily backups of alerts, drawings, settings and keys (Docker: this host folder; blank: docker-compose.yml's default).
# Keep it private: the backups hold your keys.
BACKUP_DIR=
# Dead-man's switch: pinged every 30s while feeds are healthy (e.g. a healthchecks.io check URL).
CHART_HEARTBEAT_URL=

# IB Gateway (quotes only, read-only API session). 4001 live gateway, 4002 paper.
IBKR_PORT=4001
IBKR_CLIENT_ID=31
# 1 live, 3 delayed
IBKR_MARKET_DATA_TYPE=1

# Seconds without a tick during Globex hours before a "feed stale" alert.
CHART_STALE_AFTER_S=120
# Worker processes for history loads (AMT, tick charts, profiles). Blank: one fewer than the cores, up to 4.
# 0: all in the server process, as before.
CHART_WORKERS=
# Host folders, relative to this one or whole paths; blank: docker-compose.yml's default.
# Your Documents folder (e.g. C:\Users\<you>\Documents), read-only at /import/documents: levels files, files to backfill:
DOCUMENTS_DIR=
# Databento downloads, read-only at /import/databento and /import/downloads, for `python -m chartsrv.databento`:
DATABENTO_DIR=
DOWNLOADS_DIR=

# Python packages your feed plugins need, built into the image (docs/FEEDS.md, Packages); then docker compose up -d --build.
# Easier: the Install button on the plugin's card in Connections.
# CHART_EXTRA_PIP=databento

# A fresh install refuses other devices (your phone through Tailscale) while no password is set; 0 lets them in without one
# CHART_REMOTE_NEEDS_PASSWORD=1
# The app answers only to its own addresses (localhost, IP addresses, its tailscale serve name, learned the first time a
# browser opens it by https://<pc-name>.<tailnet>.ts.net), so another site's page open on the PC can't use it. Another
# name you open it by (the PC's name, your proxy in front of it, Apache's too, which passes it in X-Forwarded-Host, the
# ts.net name over plain http or through a Tailscale older than 1.44), comma-separated (a proxy passes the port on too,
# nginx's Host $http_host, not $host: docs/PHONE.md, Login):
# CHART_ALLOWED_HOSTS=
